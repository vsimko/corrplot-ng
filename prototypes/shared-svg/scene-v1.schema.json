{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corrplot-ng.invalid/schema/scene-v1.schema.json",
  "title": "corrplot-ng renderer-neutral scene v1",
  "description": "Output contract for a prepared correlation-plot scene. Coordinates are logical canvas units, not pixels.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "width",
    "height",
    "labels",
    "cells",
    "title",
    "description",
    "annotation",
    "style"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "enum": [
        "correlation_plot",
        "general_matrix_plot"
      ]
    },
    "width": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "height": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "row_x",
          "row_y",
          "column_x",
          "column_y"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "row_x": {
            "type": "number"
          },
          "row_y": {
            "type": "number"
          },
          "column_x": {
            "type": "number"
          },
          "column_y": {
            "type": "number"
          },
          "row_visible": {
            "type": "boolean"
          },
          "column_visible": {
            "type": "boolean"
          },
          "row_position": {
            "enum": [
              "left",
              "diagonal"
            ]
          },
          "column_position": {
            "enum": [
              "top",
              "diagonal"
            ]
          },
          "column_rotation": {
            "type": "number"
          },
          "offset": {
            "type": "number"
          },
          "plotmath": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "prefix",
              "source"
            ],
            "properties": {
              "prefix": {
                "enum": [
                  ":",
                  "=",
                  "$"
                ]
              },
              "source": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "row",
          "column",
          "value",
          "x",
          "y",
          "center_x",
          "center_y",
          "size"
        ],
        "properties": {
          "row": {
            "type": "integer",
            "minimum": 0
          },
          "column": {
            "type": "integer",
            "minimum": 0
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "center_x": {
            "type": "number"
          },
          "center_y": {
            "type": "number"
          },
          "size": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "color": {
            "$ref": "#/$defs/color"
          },
          "visible": {
            "type": "boolean"
          },
          "method": {
            "enum": [
              "circle",
              "square",
              "ellipse",
              "number",
              "shade",
              "color",
              "pie"
            ]
          },
          "region": {
            "enum": [
              "upper",
              "lower",
              "diagonal"
            ]
          },
          "p_value": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "normalized_value": {
            "type": [
              "number",
              "null"
            ],
            "description": "Optional visual-only normalized value used for glyph magnitude; value remains the original matrix entry."
          }
        }
      }
    },
    "annotation": {
      "type": "string"
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "positive_color",
        "negative_color",
        "zero_color",
        "missing_fill",
        "grid_color"
      ],
      "properties": {
        "positive_color": {
          "$ref": "#/$defs/color"
        },
        "negative_color": {
          "$ref": "#/$defs/color"
        },
        "zero_color": {
          "$ref": "#/$defs/color"
        },
        "missing_fill": {
          "$ref": "#/$defs/color"
        },
        "grid_color": {
          "$ref": "#/$defs/color"
        }
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label_font_family",
        "label_font_size",
        "label_font_weight",
        "column_label_orientation",
        "label_collision"
      ],
      "properties": {
        "label_font_family": {
          "type": "string",
          "minLength": 1
        },
        "label_font_size": {
          "type": "number",
          "minimum": 6,
          "maximum": 48
        },
        "label_font_weight": {
          "enum": [
            "normal",
            "bold"
          ]
        },
        "column_label_orientation": {
          "enum": [
            "vertical",
            "horizontal"
          ]
        },
        "label_collision": {
          "enum": [
            "preserve",
            "wrap",
            "truncate",
            "omit"
          ]
        }
      }
    },
    "legend": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "label",
          "color"
        ],
        "properties": {
          "kind": {
            "enum": [
              "stop",
              "interval",
              "missing"
            ]
          },
          "label": {
            "type": "string"
          },
          "color": {
            "$ref": "#/$defs/color"
          }
        }
      }
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "glyph_method": {
      "enum": [
        "circle",
        "square",
        "ellipse",
        "number",
        "shade",
        "color",
        "pie"
      ]
    },
    "text_annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "row",
          "column",
          "role",
          "text",
          "color",
          "font_size",
          "font_weight",
          "font_style"
        ],
        "properties": {
          "row": {
            "type": "integer",
            "minimum": 0
          },
          "column": {
            "type": "integer",
            "minimum": 0
          },
          "role": {
            "enum": [
              "coefficient",
              "value"
            ]
          },
          "text": {
            "type": "string"
          },
          "color": {
            "type": "string",
            "minLength": 1
          },
          "font_size": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "font_weight": {
            "enum": [
              "normal",
              "bold"
            ]
          },
          "font_style": {
            "enum": [
              "normal",
              "italic"
            ]
          }
        }
      }
    },
    "display_type": {
      "enum": [
        "full",
        "upper",
        "lower",
        "diagonal"
      ]
    },
    "show_diagonal": {
      "type": "boolean"
    },
    "variable_order": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "indices",
        "labels"
      ],
      "properties": {
        "strategy": {
          "type": "string"
        },
        "indices": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "uniqueItems": true
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "matrix_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "color_limits",
        "color_mapping",
        "normalization"
      ],
      "properties": {
        "mode": {
          "enum": [
            "correlation",
            "general_numeric"
          ]
        },
        "color_limits": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "color_mapping": {
          "enum": [
            "sequential",
            "diverging"
          ]
        },
        "normalization": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "intercept",
            "zoom"
          ],
          "properties": {
            "intercept": {
              "type": "number"
            },
            "zoom": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "palette": {
          "type": "string",
          "minLength": 1,
          "description": "Selected legacy-compatible palette name, such as YlOrBr or RdBu."
        }
      }
    }
  },
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "correlation_plot"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "cells": {
            "items": {
              "properties": {
                "value": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": -1,
                  "maximum": 1
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "general_matrix_plot"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "matrix_semantics"
        ],
        "properties": {
          "matrix_semantics": {
            "properties": {
              "mode": {
                "const": "general_numeric"
              }
            }
          }
        }
      }
    }
  ]
}
