{
  "schema_version": 1,
  "kind": "normalized_matrix_invalid_cases",
  "cases": [
    {
      "id": "rectangular-matrix",
      "expected_error": "values must be a square matrix",
      "input": {
        "schema_version": 1,
        "kind": "normalized_matrix",
        "labels": [
          "A",
          "B"
        ],
        "values": [
          [
            1,
            0,
            2
          ],
          [
            0,
            1,
            0
          ]
        ],
        "source": {
          "format": "r_matrix",
          "row_labels_present": true,
          "column_labels_present": true
        },
        "source_indices": [
          0,
          1
        ]
      }
    },
    {
      "id": "duplicate-labels",
      "expected_error": "labels must be unique",
      "input": {
        "schema_version": 1,
        "kind": "normalized_matrix",
